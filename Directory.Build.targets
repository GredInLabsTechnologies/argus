<Project>
  <!--
    CI-only relaxations, active ONLY when building against the WDK NuGet package (WDKContentRoot
    is set). A local EWDK build leaves WDKContentRoot empty and is completely unaffected.

    The CI job validates that the driver COMPILES, not that it passes WHQL-grade static analysis or
    INF verification. Those two checks rely on the WDK's x86 plug-ins (WindowsPrefast.dll /
    InfVerif.dll), which fail to load on the hosted runner (C1250 / "Unable to load DLL"). They are
    not needed to prove the code builds, so we switch them off for the NuGet build only.
  -->

  <!-- Disable PREfast (/analyze) and ApiValidator: both are WHQL-grade checks whose WDK x86
       plug-ins (WindowsPrefast.dll / ApiValidator.exe) fail to load on the hosted runner. PREfast
       is gated by RunCodeAnalysis/EnablePREfast; ApiValidator by ApiValidator_Enable. -->
  <PropertyGroup Condition="'$(WDKContentRoot)' != ''">
    <RunCodeAnalysis>false</RunCodeAnalysis>
    <ApiValidator_Enable>false</ApiValidator_Enable>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(WDKContentRoot)' != ''">
    <ClCompile>
      <EnablePREfast>false</EnablePREfast>
    </ClCompile>
  </ItemDefinitionGroup>

  <!-- Skip INF verification: the WDK's InfVerif target keys off '@(Inf)' (not a property), so this
       no-op override replaces it for the NuGet build. -->
  <Target Name="InfVerif" Condition="'$(WDKContentRoot)' != ''" />
</Project>
